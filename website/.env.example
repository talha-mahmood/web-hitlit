# Same Supabase project the mobile app uses (EXPO_PUBLIC_SUPABASE_URL /
# EXPO_PUBLIC_SUPABASE_ANON_KEY in the app's .env).
VITE_SUPABASE_URL=https://gexddahyiaphsjevsnng.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public address of the website (share-card URLs, robots.txt, sitemap.xml).
VITE_SITE_URL=https://hitlit.pk

# Show "Sign in with Apple" on the website. Leave false until Apple is set up
# for web in Supabase (Auth > Providers > Apple: Services ID + secret key) —
# the app's native Apple sign-in does not need that, the web redirect flow does.
VITE_ENABLE_APPLE_SIGNIN=false

# In-app court booking (slot picker -> checkout). Off in the app today (courts
# are info-only; booking is via WhatsApp/phone) - keep false to match it.
VITE_ENABLE_ONLINE_BOOKING=false
