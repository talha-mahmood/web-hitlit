{
  "expo": {
    "name": "PlayOye",
    "slug": "hamza-playpal-app",
    "scheme": "playoye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.playoye.app"
    },
    "android": {
      "package": "com.playoye.app",
      "adaptiveIcon": {
        "backgroundColor": "#002C13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "PlayOye needs access to your photos so you can set a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlayOye needs your location to set your squad's location automatically."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "0b193f9f-9736-4125-9a9e-db47d973b92d"
      }
    },
    "owner": "devnexsolutions"
  }
}
